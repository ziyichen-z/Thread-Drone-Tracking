]


def part_a():
    results = []
    print("## (a) §9.3 具名映射")
    print("### 第 1 行：新句命中（HEAD 中锚点起 ±6 行窗口去空白拼接后含 " + " / ".join(KEY_PHRASES) + "）")
    for rel, anchor, where in NEW_ROW1:
        lines = (REPO / rel).read_text(encoding="utf-8").splitlines()
        base_hit = anchor in git(["show", f"{BASE}:{rel}"], REPO).stdout
        idx = next((i for i, l in enumerate(lines) if anchor in l), None)
        ok = False
        shown = ""
        if idx is not None:
            lo, hi = max(0, idx - 6), min(len(lines), idx + 7)
            window = "".join(l.strip() for l in lines[lo:hi]).replace(" ", "")
            ok = all(k.replace(" ", "") in window for k in KEY_PHRASES)
            hit = next((j for j in range(lo, hi) if "D1 在效" in lines[j] or "信封 D1" in lines[j]), None)
            shown = f"{rel}:{hit + 1}: {lines[hit].strip()}" if hit is not None else "(窗口内无 D1 在效行)"
        verdict = "pass" if ok and base_hit else "fail"
        results.append(verdict)
        print(f"- [{verdict}] {where}｜锚点在 {BASE} 存在={base_hit}｜HEAD 锚点行={idx + 1 if idx is not None else None}｜{shown}")
    print("### 第 2–4 行：「不改」位置与 bcc2c68^ 逐字比对（原行整行出现在 HEAD 同名文件；否则原行须整句作为 HEAD 某行行首逐字保留，并列出行尾追加）")
    for rel, lineno, row, where in UNCHANGED:
        base_lines = git(["show", f"{BASE}:{rel}"], REPO).stdout.splitlines()
        head_lines = (REPO / rel).read_text(encoding="utf-8").splitlines()
        if lineno is None:  # AGENTS「共享状态更新」中与 workflow §7 规则 7 同句
            lineno = next(i + 1 for i, l in enumerate(base_lines) if "写入归因" in l)
        original = base_lines[lineno - 1]
        positions = [i + 1 for i, l in enumerate(head_lines) if l == original]
        note = "整行逐字"
        if not positions:  # 句级：原行整句逐字保留为 HEAD 某行行首，行尾另有追加
            pre = [i for i, l in enumerate(head_lines) if l.startswith(original) and len(l) > len(original)]
            if pre:
                positions = [i + 1 for i in pre]
                note = f"句级逐字（原句为该行行首，行尾追加「{head_lines[pre[0]][len(original):].strip()}」）"
        verdict = "pass" if positions else "fail"
        results.append(verdict)
        print(f"- [{verdict}] {row} {where}｜{BASE}:{rel}:{lineno} → HEAD 行 {positions}｜{note}｜「{original.strip()}」")
    return results


# ---------------------------------------------------------------- (b)
ROLE_TITLE = {"ideation": "Ideation", "acceptance": "Acceptance",
              "implementation": "Implementation", "review": "Review", "chore": "Chore"}
ACCEPT_TOKENS = re.compile(r"^(ACCEPTED|REVISION_REQUESTED\w*|REJECTED|REWORK_REQUIRED|REVIEW_PASSED|"
                           r"UNITY_\w+|BLOCKED\w*|DEFERRED_\w+|DONE|CLOSED_\w+)$")


def board_text(overall, lifecycle, impl_col, owner, status, progress, log=""):
    return f"""# Current status（{drill.SYNTHETIC_MARK}）

## Gate board

| Work ID | Scope | Design | Implementation/auto evidence | Independent review | Unity/hardware | Overall | Lifecycle |
|---|---|---|---|---|---|---|---|
| `{WID}` | 合成演练工作项 | 合成 | {impl_col} | `N/A` | `N/A` | `{overall}` | `{lifecycle}` |
| `DRILL-002` | 合成旁观行 | 合成 | 合成 | `N/A` | `N/A` | `ACCEPTED` | `ACTIVE` |

## Active handoffs

| Owner/next role | Work ID | Requested action | Scope | Progress | Status | Consuming | Return to |
|---|---|---|---|---|---|---|---|
| {owner} | `{WID}`@{overall} | 合成演练交接 | — | {progress} | `{status}` | no | — |

## Log
{log}"""


def section_rows(text, title):
    rows, inside = [], False
    for line in text.splitlines():
        if line.startswith("## "):
            inside = line.strip() == f"## {title}"
            continue
        if inside and line.strip().startswith("|"):
            rows.append([c.strip() for c in line.strip().strip("|").split("|")])
    header = rows[0] if rows else []
    body = [r for r in rows[1:] if not all(set(c) <= set("-: ") for c in r)]
    return header, body


def gate_cols(text):
    header, body = section_rows(text, "Gate board")
    ci, co, cl = header.index("Work ID"), header.index("Overall"), header.index("Lifecycle")
    return {r[ci].strip("`"): (r[co].strip("`"), r[cl].strip("`")) for r in body}


def handoff(text):
    header, body = section_rows(text, "Active handoffs")
    cw, cs, cp, cown = (header.index("Work ID"), header.index("Status"),
                        header.index("Progress"), header.index("Owner/next role"))
    for r in body:
        if f"`{WID}`" in r[cw]:
            return {"owner": r[cown], "status": r[cs].strip("`"), "progress": r[cp]}
    return None


class Fixture:
    def __init__(self, root: Path):
        self.root = root / "fixture"
        drill.build_drill_repo(self.root)
        self.remote = root / "remote.git"
        git(["init", "-q", "--bare", str(self.remote)], root)
        git(["remote", "add", "origin", str(self.remote)], self.root)
        git(["branch", "-M", "main"], self.root)

    def write(self, rel, text):
        p = self.root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")

    def commit(self, message):
        git(["add", "-A"], self.root)
        git(["commit", "-q", "-m", message], self.root)
        return git(["rev-parse", "HEAD"], self.root).stdout.strip()

    def push(self):
        git(["push", "-q", "origin", "HEAD:main"], self.root)

    def show(self, rev, rel):
        return git(["show", f"{rev}:{rel}"], self.root).stdout

    def message(self, sha):
        return git(["log", "-1", "--format=%B", sha], self.root).stdout


def dispatch_commits(fx, did):
    out = git(["log", "--reverse", "--format=%H", f"--grep=Dispatch-Id: {did}"], fx.root).stdout
    return out.split()


def f1(fx, commits, role):
    for c in commits:
        msg = fx.message(c)
        if not re.search(rf"^Role-Check: {re.escape(role)} pass$", msg, re.M):
            return "fail", f"{c[:8]} 缺 `Role-Check: {role} pass` 尾注"
    return "pass", f"{len(commits)} 个派发提交均带尾注"


def f2(fx, cand):
    git(["fetch", "-q", "origin", "main"], fx.root)
    r = git(["merge-base", "--is-ancestor", cand, "refs/remotes/origin/main"], fx.root, check=False)
    return ("pass", "候选在 origin/main") if r.returncode == 0 else ("fail", "候选不在 origin/main")


def f3a(fx, cand, rnd, report):
    h = handoff(fx.show(cand, "docs/current-status.md"))
    if not h or not h["status"]:
        return "fail", "交接行缺失或 Status 为空"
    if rnd not in h["status"] and rnd not in h["progress"]:
        return "fail", f"Status/Progress 不含轮次字面 {rnd}"
    if report is not None and (report["handoff"]["owner"] != h["owner"]
                               or report["handoff"]["status"] != h["status"]):
        return "fail", f"报告 handoff={report['handoff']} ≠ 磁盘 Owner={h['owner']} Status={h['status']}"
    return "pass", f"Owner={h['owner']} Status={h['status']}"


def f3b(fx, base, cand, role):
    before = gate_cols(fx.show(base, "docs/current-status.md"))
    after = gate_cols(fx.show(cand, "docs/current-status.md"))
    for wid in set(before) | set(after):
        b, a = before.get(wid), after.get(wid)
        if b == a:
            continue
        if wid != WID:
            return "fail", f"非本 work ID 行 {wid} 两列变化 {b}→{a}"
        if role == "acceptance":
            continue
        if role == "ideation":
            if b is None and a == ("PROPOSED", "ACTIVE"):
                continue
            if (b and a and b[1] == a[1] and re.match(r"REVISION_REQUESTED", b[0])
                    and re.fullmatch(r"PROPOSED_D\d+", a[0])):
                continue
            return "fail", f"构思派发越权 {b}→{a}"
        if role == "implementation":
            if b and a and b[1] == a[1] and a[0] in ("IMPLEMENTING", "IMPLEMENTED"):
                continue
            return "fail", f"实现派发越权 {b}→{a}"
        return "fail", f"{role} 派发两列不得变 {b}→{a}"
    return "pass", "两列变化落在允许集内"


def f4(fx, cand):
    board = fx.show(cand, "docs/current-status.md")
    paths = re.findall(r"`(docs/[^`#]+)`", board)
    missing = [p for p in paths if git(["cat-file", "-e", f"{cand}:{p}"], fx.root, check=False).returncode]
    return ("fail", f"路径不存在 {missing}") if missing else ("pass", f"{len(paths)} 个路径存在")


def f5(fx, cand, report):
    board = fx.show(cand, "docs/current-status.md")
    claims = re.findall(r"`(docs/[^`]+)` Ran (\d+)", board)
    if report is not None:
        claims += [(p, n) for p, n in report.get("numbers", [])]
    if not claims:
        return "N/A", "无数字主张"
    for path, n in claims:
        m = re.search(r"^Ran (\d+)", fx.show(cand, path), re.M)
        if not m or m.group(1) != str(n):
            return "fail", f"主张 Ran {n} ≠ {path} 具名行 {m.group(0) if m else '缺'}"
    return "pass", f"{len(claims)} 处数字一致"


def f6(fx, base, cand, report):
    diff = git(["diff", f"{base}..{cand}", "--", "docs/authorizations.md"], fx.root).stdout
    if any(l.startswith("+## ") for l in diff.splitlines()):
        return "fail", "账本新增 `## ` 条目"
    if report is not None and report.get("claims_ledger_written"):
        return "fail", "报告称已写账本用户原话"
    return "pass", "账本无新增条目"


def f8(fx, commits, rnd, report):
    for c in commits:
        subj = fx.message(c).splitlines()[0]
        if not subj.startswith(f"{WID} ") or rnd not in subj:
            return "fail", f"主题「{subj}」不含 {WID} 前缀或轮次 {rnd}"
    if report is not None and report["this_round"] != rnd:
        return "fail", f"报告 this_round={report['this_round']} ≠ requested.round={rnd}"
    return "pass", f"主题与轮次 {rnd} 一致"


def f9(fx, commits, expected_cand):
    text = fx.show(commits[-1], "docs/reviews/DRILL-001.md")
    m = re.search(r"^round_candidate: ([0-9a-f]{40})$", text, re.M)
    if not m:
        return "fail", "缺 round_candidate:"
    rc = m.group(1)
    if rc in commits:
        return "fail", f"round_candidate={rc[:8]} 是复核提交自身"
    if rc != expected_cand:
        return "fail", f"round_candidate={rc[:8]} ≠ 解析候选 {expected_cand[:8]}"
    return "pass", f"round_candidate={rc[:8]} = 解析候选"


def f10(fx, cand):
    text = fx.show(cand, "docs/evidence/DRILL-001-self-attestation.md")
    rows = [l for l in text.splitlines() if l.startswith("- AC-")]
    bad = [l for l in rows if not re.search(r"(test|artifact|cmd):", l)]
    if "## 停点自证" not in text or not rows or bad:
        return "fail", "自证小节缺失或指针不全"
    return "pass", f"{len(rows)} 条 AC 均带指针"


def trailers(did, role, drop_role_check=False):
    t = drill.commit_trailers(did, role)
    return t.split("\n")[0] if drop_role_check else t


def run_case(case, tmp):
    fx = Fixture(tmp)
    # 起始状态（已推送，= base_head）
    fx.write("docs/current-status.md", board_text(**case["before"]))
    fx.write("docs/evidence/DRILL-001-tests.log", "Ran 11 tests\n\nOK\n")
    base = fx.commit(f"{WID} D0 起始状态（{drill.SYNTHETIC_MARK}）")
    fx.push()
    role, rnd = case["role"], case["round"]
    did = f"{WID}-{rnd}-20260925T120000Z-a3c{len(case['name']) % 10}"
    expected_cand = None
    if role == "review":
        expected_cand = base  # 上一实现派发的候选（夹具内以 base_head 充当）
        fx.write("docs/reviews/DRILL-001.md", f"# 复核（合成）\n\nround_candidate: {base}\n")
        first = fx.commit(f"{WID} {rnd} 复核草稿\n\n{trailers(did, role)}")
        if case.get("self_candidate"):
            fx.write("docs/reviews/DRILL-001.md", f"# 复核（合成）\n\nround_candidate: {first}\n")
            fx.commit(f"{WID} {rnd} 复核定稿\n\n{trailers(did, role)}")
    else:
        after = dict(case["after"])
        fx.write("docs/current-status.md", board_text(**after))
        for rel, text in case.get("files", {}).items():
            fx.write(rel, text)
        subject = case.get("subject", f"{WID} {rnd} 合成派发提交")
        fx.commit(f"{subject}\n\n{trailers(did, role, case.get('drop_role_check', False))}")
    if not case.get("no_push"):
        fx.push()
    commits = dispatch_commits(fx, did)
    cand = commits[-1]
    report = case.get("report")
    res = {
        "F1": f1(fx, commits, role),
        "F2": f2(fx, cand),
        "F3a": f3a(fx, cand, rnd, report),
        "F3b": f3b(fx, base, cand, role),
        "F4": f4(fx, cand),
        "F5": f5(fx, cand, report),
        "F6": f6(fx, base, cand, report),
        "F8": f8(fx, commits, rnd, report),
        "F9": f9(fx, commits, expected_cand) if role == "review" else ("N/A", "非复核轮"),
        "F10": f10(fx, cand) if case.get("impl_stop") else ("N/A", "非实现停点"),
    }
    return res


def rep(owner, status, rnd, **extra):
    return {"handoff": {"owner": owner, "status": status}, "this_round": rnd, **extra}


