(b) 在 tools/make_supervisor_drill.py 生成的合成夹具内，按提案 §4 实现 F1–F10
    的可机械部分，跑 §4 九个反例（须判失败）与三个通过例（须判通过）。
合成演练，不构成任何真实 D/C/R 轮次或门决定；只读真实仓库，夹具在临时目录。
用法：python3 route_check.py <仓库根>
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(sys.argv[1]).resolve()
sys.path.insert(0, str(REPO))
from tools import make_supervisor_drill as drill  # noqa: E402

BASE = "bcc2c68^"
WID = drill.DRILL_WORK_ID


def git(args, cwd, check=True):
    r = subprocess.run(["git", "-c", "user.name=drill", "-c", "user.email=drill@example.com",
                        *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr}")
    return r


# ---------------------------------------------------------------- (a)
NEW_ROW1 = [  # (文件, bcc2c68^ 锚点原句（该位置旧句的片段）, §9.3 所列位置)
    ("docs/collaboration-workflow.md", "必须上交", "workflow §4.2 L201–203"),
    ("docs/engineering-workflow.md", "退修上限不变：同一范围第二次退修后仍上交用户二选一", "engineering §3 L67"),
    ("docs/roles/acceptance.md", "上交用户二选一（workflow §4.2 退修上限，计数追溯生效）", "acceptance L19"),
    ("docs/roles/ideation.md", "第三次裁定由用户二选一", "ideation L11"),
