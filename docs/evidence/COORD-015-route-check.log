def fmt(res):
    return "；".join(f"{k}={v[0]}" for k, v in res.items())


def part_b():
    results = []
    print("\n## (b) §4 反例 9 例（须判失败）与通过例 3 例（须判通过），合成夹具内")
    for case in NEG_CASES:
        with tempfile.TemporaryDirectory(prefix="coord015-a3-") as tmp:
            res = run_case(case, Path(tmp))
        tgt = res[case["target"]]
        others_ok = all(v[0] in ("pass", "N/A") for k, v in res.items() if k != case["target"])
        verdict = "pass" if tgt[0] == "fail" and others_ok else "fail"
        results.append(verdict)
        print(f"- [{verdict}] {case['name']}｜目标 {case['target']}={tgt[0]}（{tgt[1]}）｜其余适用项全过={others_ok}｜{fmt(res)}")
    for case in PASS_CASES:
        with tempfile.TemporaryDirectory(prefix="coord015-a3-") as tmp:
            res = run_case(case, Path(tmp))
        ok = all(v[0] in ("pass", "N/A") for v in res.values())
        verdict = "pass" if ok else "fail"
        results.append(verdict)
        print(f"- [{verdict}] {case['name']}｜{fmt(res)}")
        for k, v in res.items():
            print(f"    {k}: {v[0]} — {v[1]}")
    return results


