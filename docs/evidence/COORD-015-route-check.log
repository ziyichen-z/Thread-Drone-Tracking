KEY_PHRASES = ["决策信封D1在效", "严格递减", "supervisor", "(a)"]

UNCHANGED = [  # (文件, bcc2c68^ 行号, §9.3 行, 位置)
    ("docs/collaboration-workflow.md", 389, "第2行（U1=D 缺省，否则不改）", "workflow §4.4 L389"),
